# Build check_link_fattening without Grid
# and run with this code to generate the fiducial fat and long link files
prompt 0
nx 8
ny 8
nz 8
nt 8
iseed 1234
reload_serial ../binary_samples/lat.sample.l8888
u0 1
forget
coordinate_origin 0 0 0 0
time_bc antiperiodic
forget
forget
withKSphases 1
number_of_masses 4
max_cg_iterations 500
max_cg_restarts 5

fresh
mass 0.01
naik_term_epsilon 0.
error_for_propagator 1e-5
rel_error_for_propagator 0

fresh
mass 0.05
naik_term_epsilon 0.
error_for_propagator 1e-5
rel_error_for_propagator 0

fresh
mass 0.5
naik_term_epsilon -0.152048264210358
error_for_propagator 1e-5
rel_error_for_propagator 0

fresh
mass 0.7
naik_term_epsilon -0.271190134429433
error_for_propagator 1e-5
rel_error_for_propagator 0

save_serial_color_matrix fiducial_mom





