######################################################################
### QUARKS

# DESCRIPTION OF QUARKS

number_of_quarks 3

# QUARKS FOR evenandodd_wall SOURCE


# MASS 0

propagator 0
identity
op_label d
forget_ksprop


# MASS 0

propagator 1
identity
op_label d
forget_ksprop


# MASS 0

propagator 2
identity
op_label d
forget_ksprop


######################################################################
### MESONS

# DESCRIPTION OF MESONS

number_of_mesons 2


# evenandodd_wall WITH funnywall1

pair 0 1
spectrum_request meson

forget_corr
r_offset 0 0 0 0

number_of_correlators 6

# Normalization is 1/vol3
correlator PION_5  p000  1 * 0.000244141 pion5  0 0 0 E E E
correlator PION_i5 p000  1 * 0.000244141 pioni5 0 0 0 E E E
correlator PION_i  p000  1 * 0.000244141 pioni  0 0 0 E E E
correlator PION_s  p000  1 * 0.000244141 pions  0 0 0 E E E
correlator RHO_i   p000  1 * 0.000244141 rhoi   0 0 0 E E E
correlator RHO_s   p000  1 * 0.000244141 rhois  0 0 0 E E E

# evenandodd_wall WITH funnywall2

pair 0 2
spectrum_request meson

forget_corr
r_offset 0 0 0 0

number_of_correlators 6

# Normalization is 1/vol3
correlator PION_05 p000  1 * 0.000244141 pion05 0 0 0 E E E
correlator PION_ij p000  1 * 0.000244141 pionij 0 0 0 E E E
correlator PION_i0 p000  1 * 0.000244141 pioni0 0 0 0 E E E
correlator PION_0  p000  1 * 0.000244141 pion0  0 0 0 E E E
correlator RHO_i0  p000  1 * 0.000244141 rhoi0  0 0 0 E E E
correlator RHO_0   p000  1 * 0.000244141 rho0   0 0 0 E E E


