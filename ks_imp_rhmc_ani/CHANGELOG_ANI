	ks_imp_rhmc_ani/lattice.h :

#ifdef ANISOTROPY
        su3_matrix staple_a[2];
        /* NOTE: a) staple_a[0] - spatial, staple_a[1] - temporal
                 b) the "staple" variable below is different from isotropic
                    case: here staple=beta[0]*staple_a[0]+beta[1]*staple_a[1],
                    while in the isotropic case it would be simply
                    staple=staple_a[0]+staple_a[1] */
#endif

#ifndef ANISOTROPY
EXTERN  Real beta,u0;
#else
EXTERN  Real beta[2],u0;
#endif



	ks_imp_rhmc_ani/params.h :

#ifndef ANISOTROPY
        Real beta;      /* gauge coupling */
#else
        Real beta[2];   /* gauge coupling: 0 - space, 1 - time */
#endif



	ks_imp_rhmc_ani/setup.c :

#ifndef ANISOTROPY
    printf("SU3 with improved KS action\n");
#else
    printf("Anisotropic SU3 with improved KS action\n");
#endif

#ifndef ANISOTROPY
    IF_OK status += get_f(stdin, prompt,"beta", &param.beta );
#else
    /* beta[0] - space, beta[1] - time */
    IF_OK status += get_vf(stdin, prompt,"beta", param.beta, 2 );
#endif

#ifndef ANISOTROPY
  beta = param.beta;
#else
  beta[0] = param.beta[0];
  beta[1] = param.beta[1];
#endif

#ifdef ANISOTROPY
        /* figure out which loops are temporal and which are spatial */
        path_determine_st();
#endif



	ks_imp_rhmc_ani/d_action_rhmc.c :

#ifndef ANISOTROPY
  g_action = -beta*volume*(ssplaq+stplaq);
#else
  g_action = -(beta[0]*ssplaq+beta[1]*stplaq)*volume;
#endif

#ifndef ANISOTROPY
    g_action = (beta/3.0)*imp_gauge_action();
#else
    g_action = imp_gauge_action()/3.0;
#endif



